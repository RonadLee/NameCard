DATABASE_URL=postgresql://namecard:namecard@localhost:5432/namecard
# Generate unique values of at least 32 characters. Production refuses the placeholders below.
JWT_ACCESS_SECRET=replace-with-a-unique-32-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
WEB_ORIGIN=http://127.0.0.1:3000
API_ORIGIN=http://127.0.0.1:4000
PORT=4000
STORAGE_DRIVER=local
# First empty workspace. Seed creates no cards, contacts, scans, or files.
